# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交。

# ===== DeepSeek LLM =====
DEEPSEEK_API_KEY=your-deepseek-api-key

# ===== LangSmith（可选，调用追踪）=====
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=smart_medical

# ===== MySQL（实体映射表）=====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=smart_medical

# ===== Neo4j（知识图谱）=====
NEO4J_URI=neo4j://localhost:7687
NEO4J_DATABASE=neo4j
# 管理员账号：仅离线导入使用
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
# 只读账号：在线 /chat 查询使用（强烈建议单独创建，仅授予 reader 角色）
NEO4J_READONLY_USER=readonly
NEO4J_READONLY_PASSWORD=change-me

# ===== PostgreSQL（对话记忆 checkpointer；留空则回退进程内 InMemory）=====
POSTGRES_URI=postgresql://postgres:change-me@localhost:5432/smart_medical

# ===== 会话 / 安全 =====
# 生成: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=change-me-to-a-strong-random-value
SESSION_HTTPS_ONLY=false          # 反向代理启用 HTTPS 后置 true

# ===== 运行参数 =====
EMBEDDING_DEVICE=auto             # auto / cpu / cuda
MAX_MESSAGE_LENGTH=2000
CHAT_RATE_LIMIT=20/minute
ENTITY_ALIGN_MAX_DISTANCE=0.35    # Chroma 余弦距离阈值（越小越严格）
HOST=127.0.0.1
PORT=8000
