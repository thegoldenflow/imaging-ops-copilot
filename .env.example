# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交。

# ===== DeepSeek LLM =====
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat          # 主对话模型（快速/便宜的 deepseek-chat）
CYPHER_CHECKER_MODEL=deepseek-chat    # Cypher 校验模型，默认同上

# ===== LangSmith（可选，调用追踪）=====
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=smart_medical

# ===== Neo4j（知识图谱）=====
NEO4J_URI=neo4j://localhost:7687
NEO4J_DATABASE=neo4j
# 管理员账号：仅离线导入使用
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
# 只读账号：在线 /chat 查询使用（强烈建议单独创建，仅授予 reader 角色）
NEO4J_READONLY_USER=readonly
NEO4J_READONLY_PASSWORD=change-me

# ===== PostgreSQL（单一库：实体映射表 entity_mapping + 对话记忆 checkpointer）=====
# 应用用 POSTGRES_URI 连接；下面 POSTGRES_USER/PASSWORD/DB 供 docker-compose 建库，二者需一致。
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/smart_medical
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_medical

# ===== Neo4j docker-compose 建库口令（与上面 NEO4J_USER/PASSWORD 一致）=====
# NEO4J_AUTH 由 compose 组装为 neo4j/<密码>

# ===== 会话 / 安全 =====
# 生成: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=change-me-to-a-strong-random-value
SESSION_HTTPS_ONLY=false          # 反向代理启用 HTTPS 后置 true

# ===== 运行参数 =====
EMBEDDING_DEVICE=auto             # auto / cpu / cuda
MAX_MESSAGE_LENGTH=2000
CHAT_RATE_LIMIT=20/minute
ENTITY_ALIGN_MAX_DISTANCE=0.35    # Chroma 余弦距离阈值（越小越严格）
# 可选：本地 SentenceTransformer 兼容的多语种模型目录。留空时英文仅走审核过的确定性别名。
# 配置后由 `python -m datasync.bilingual_terminology` 构建独立索引，不影响现有中文 BGE 索引。
MULTILINGUAL_EMBEDDING_MODEL_PATH=
MULTILINGUAL_VECTOR_COLLECTION=smart_medical_multilingual_v1
MULTILINGUAL_ENTITY_ALIGN_MAX_DISTANCE=0.25
MULTILINGUAL_ENTITY_ALIGN_MIN_MARGIN=0.05
HOST=127.0.0.1
PORT=8000
