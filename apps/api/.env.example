# Copy to apps/api/.env (git-ignored) or set these as environment variables.
# Never commit real keys.

# Model provider: anthropic, gemini or mock. Unset: anthropic when
# ANTHROPIC_API_KEY is set, otherwise mock. A provider without its key runs as mock.
# LLM_PROVIDER=anthropic

# Claude (default provider)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL_REASONING=claude-sonnet-5-5
# CLAUDE_MODEL_FAST=claude-haiku-4-5
# CLAUDE_MODEL_VOICE=claude-haiku-4-5

# Google Gemini through Google Cloud Agent Platform / Vertex AI (used when LLM_PROVIDER=gemini).
# This is not a Google AI Studio / Gemini Developer API key.
GOOGLE_AGENT_PLATFORM_API_KEY=
# GEMINI_MODEL_REASONING=gemini-3.5-flash
# GEMINI_MODEL_FAST=gemini-3.5-flash
# GEMINI_MODEL_VOICE=gemini-3.5-flash

# Release gate (docs/SPEC-hospital.md 6.4, 6.6): demo runs every registered agent and marks the output of one whose
# latest eval has not passed "Not evaluated"; prod refuses such agents (the modules fall back to their rules or a
# person). Every committed eval run is a mock baseline, so in prod the AI steps are off until a live run passes.
# APP_MODE=demo

# Optional overrides
# Seconds per model call, retries included; an agent's model_policy.timeout_s overrides it
# LLM_TIMEOUT_S=30
# SEED=42
# Require a passcode on the demo login page (set this for public deployments)
# DEMO_PASSCODE=
# CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL 16). Local development: `docker compose up -d postgres` from the
# repository root publishes it on 127.0.0.1:5433, which is the default below. The API creates the tables and the
# demo data, not the database: for another name run `docker compose exec postgres createdb -U ioc <name>` first.
# Tests use TEST_DATABASE_URL (default .../ioc_test), which they drop and recreate.
# DATABASE_URL=postgresql+psycopg://ioc:ioc@127.0.0.1:5433/ioc

# PHI field encryption (AES-GCM) and blind-index (HMAC) keys, base64, 32 bytes each.
# Required. Generate with `uv run python -m app.core.db.crypto`. They belong with the
# database: losing them makes the stored PHI unreadable; back them up separately.
PHI_ENCRYPTION_KEY=
PHI_BLIND_INDEX_KEY=

# Hospital EHR behind FhirGateway (docs/data-model.md). "local" keeps the FHIR resources in
# PostgreSQL; "hapi" reads and writes a FHIR server instead (`docker compose --profile ehr up -d hapi`,
# then `uv run python scripts/load_fhir.py`).
# FHIR_BACKEND=local
# FHIR_BASE_URL=http://localhost:8080/fhir
# none for the local HAPI; smart_backend (SMART Backend Services, client credentials + JWT) is
# defined for a real EHR but not implemented in the demo.
# FHIR_AUTH_MODE=none
# FHIR_CLIENT_ID=
# FHIR_TOKEN_URL=

# Durable workflows (Temporal, docs/SPEC-hospital.md 6.5). Unset address: off, the workflow view says "offline"
# and every module works without it. Local: `docker compose --profile workflows up -d temporal`, then the worker
# in a terminal: `uv run python -m app.workflows.worker` (or TEMPORAL_WORKER_IN_API=1 to run it inside the API).
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=hospital-demo
# TEMPORAL_TASK_QUEUE=hospital-workflows
# TEMPORAL_WORKER_IN_API=0
# Timer durations of new workflows, in seconds (wall clock): sign-off 24 h, escalation another 24 h, the follow-up
# call 48 h after discharge, the capacity re-check 1 h after an approved action. Shorten them for a demo (the
# storyline's follow-up step waits for WORKFLOW_FOLLOWUP_DELAY_S, e.g. 20). In docker compose the API and the worker
# reach the dev server as temporal:7233 (TEMPORAL_ADDRESS=temporal:7233 docker compose --profile workflows up -d).
# WORKFLOW_SIGNOFF_TIMEOUT_S=86400
# WORKFLOW_ESCALATION_TIMEOUT_S=86400
# WORKFLOW_FOLLOWUP_DELAY_S=172800
# WORKFLOW_VERIFY_AFTER_S=3600
# Where the low-confidence review loop appends eval cases (default: the repository's evals/).
# AGENT_EVALS_DIR=

# Patient voice services (7.4), hospital clock: the follow-up call is due this many hours after discharge; the
# background sweep schedules stays discharged up to the window's end; an escalated patient is told a nurse calls
# back within this many minutes.
# FOLLOWUP_CALL_DELAY_H=48
# FOLLOWUP_CALL_WINDOW_H=72
# FOLLOWUP_CALLBACK_MINUTES=30

# Clinical knowledge graph folder (default: apps/kg-qa/data/knowledge_graph; the Docker image sets its own).
# CLINICAL_KG_DIR=

# Regenerate the demo data once a day at this hour (0-23, server time). Unset: never.
# DEMO_DAILY_RESET_HOUR=4
# Turn off the background workers (message dispatch, intake pipeline, escalations).
# BACKGROUND_WORKERS=0
# Pause the background work that calls the model (the simulator clock, AI intake, narration, order-review
# commentary) after this many minutes without a signed-in person using the app; the next request resumes it.
# Rule-based work (message dispatch, escalations, reminders, the daily reset) goes on. 0: never pause.
# IDLE_PAUSE_MINUTES=15
# Daily cap on model spend in USD (server's day). Past it the gateway refuses every model call ("AI temporarily
# unavailable") until midnight; non-AI features keep working. Unset: no cap. Set it on a server with a real key.
# LLM_DAILY_BUDGET_USD=5

# Server deployment only (docker-compose.prod.yml, see docs/DEPLOY.md).
# Use a version tag, not just latest, so you can roll back.
# API_IMAGE=wsyjh8/imaging-ops-api:v0.1.0
# WEB_IMAGE=wsyjh8/imaging-ops-web:v0.1.0
# WEB_PORT=8080
