# Copy to apps/api/.env (git-ignored) or set these as environment variables.
# Never commit real keys.

# Model provider: anthropic, gemini or mock. Unset: anthropic when
# ANTHROPIC_API_KEY is set, otherwise mock. A provider without its key runs as mock.
# LLM_PROVIDER=anthropic

# Claude (default provider)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL_REASONING=claude-sonnet-5-5
# CLAUDE_MODEL_FAST=claude-haiku-4-5
# CLAUDE_MODEL_VOICE=claude-haiku-4-5

# Google Gemini through Google Cloud Agent Platform / Vertex AI (used when LLM_PROVIDER=gemini).
# This is not a Google AI Studio / Gemini Developer API key.
GOOGLE_AGENT_PLATFORM_API_KEY=
# GEMINI_MODEL_REASONING=gemini-3.5-flash
# GEMINI_MODEL_FAST=gemini-3.5-flash
# GEMINI_MODEL_VOICE=gemini-3.5-flash

# Optional overrides
# LLM_TIMEOUT_S=30
# SEED=42
# Require a passcode on the demo login page (set this for public deployments)
# DEMO_PASSCODE=
# CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL 16). Local development: `docker compose up -d postgres` from the
# repository root publishes it on 127.0.0.1:5433, which is the default below.
# DATABASE_URL=postgresql+psycopg://ioc:ioc@127.0.0.1:5433/ioc

# PHI field encryption (AES-GCM) and blind-index (HMAC) keys, base64, 32 bytes each.
# Required. Generate with `uv run python -m app.core.db.crypto`. They belong with the
# database: losing them makes the stored PHI unreadable; back them up separately.
PHI_ENCRYPTION_KEY=
PHI_BLIND_INDEX_KEY=

# Regenerate the demo data once a day at this hour (0-23, server time). Unset: never.
# DEMO_DAILY_RESET_HOUR=4
# Turn off the background workers (message dispatch, intake pipeline, escalations).
# BACKGROUND_WORKERS=0

# Server deployment only (docker-compose.prod.yml, see docs/DEPLOY.md).
# Use a version tag, not just latest, so you can roll back.
# API_IMAGE=wsyjh8/imaging-ops-api:v0.1.0
# WEB_IMAGE=wsyjh8/imaging-ops-web:v0.1.0
# WEB_PORT=8080
